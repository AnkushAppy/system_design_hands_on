# Repo-wide ignores — applies to all subfolders (Python venvs, caches, OS junk, etc.)

# Python
# Virtual environments (any depth: e.g. language_learning/.../dependency_injection/.venv)
**/.venv/
**/venv/
**/.Python/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.eggs/
**/dist/
**/build/
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/
.coverage
htmlcov/
**/.hypothesis/

# Virtualenv / pip
pip-log.txt
pip-delete-this-directory.txt

# Environment & local secrets
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Editors / IDEs (uncomment if you do not commit shared editor config)
# .vscode/
# .idea/

# Logs & temp
*.log
*.tmp
*.temp
*~

# Generated metrics artifacts (from export/chart scripts in subprojects)
**/metrics/exports/**/*.json
**/metrics/charts/*.png
**/metrics/charts/*.svg

# JavaScript / Node (future subprojects)
**/node_modules/

# SQLite (local DB files from exercises, e.g. FastAPI + SQLAlchemy)
**/test.db
*.db-shm
*.db-wal
*.db-journal

# Docker
*.orig
